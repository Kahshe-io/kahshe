{
  "name": "kahshe",
  "version": "1.1.0",
  "scheme": "dual",
  "color": {
    "ink":          { "value": "#0C1417", "use": "text, dark grounds, icon tile" },
    "primary":      { "value": "#12727C", "use": "brackets, links, focus, active state" },
    "primaryTint":  { "value": "#5FBFC7", "use": "primary substitute on dark grounds only" },
    "signal":       { "value": "#F0A62B", "use": "a match — dark grounds only" },
    "signalDeep":   { "value": "#8A5A0F", "use": "a match — light grounds" },
    "signalWash":   { "value": "#FDF4E4", "use": "matched row background on light grounds" },
    "surface":      { "value": "#F2F5F6", "use": "panels, stages" },
    "line":         { "value": "#E0E7E8", "use": "borders, rules" },
    "grey":         { "value": "#647579", "use": "secondary text, metadata" },
    "wash":         { "value": "#DCEFF1", "use": "clearspace diagrams, subtle teal fills" }
  },
  "font": {
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "weights": { "sansBody": 400, "sansStrong": 600, "monoBody": 400, "monoStrong": 500 }
  },
  "wordmark": { "tracking": "-0.03em", "case": "lowercase", "bracketFamily": "mono", "bracketWeight": 400 },
  "contrast": {
    "inkOnWhite": "18.6:1",
    "primaryOnWhite": "5.6:1",
    "primaryTintOnInk": "8.6:1",
    "signalOnInk": "9.0:1",
    "signalDeepOnWhite": "5.9:1",
    "greyOnWhite": "4.8:1",
    "forbidden": "signal (#F0A62B) as text on white — 2.1:1"
  }
}
